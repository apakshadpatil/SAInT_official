rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public site configuration & static metadata
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public committee member cards on homepage
    match /siteMembers/{memberId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public club positions
    match /positions/{positionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public recruitment interview sections
    match /interviewSections/{sectionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public events (all events readable by anyone for public portal, registration, and activities; writes require auth)
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Event tickets subcollection (public ticket creation on registration, authenticated reading/scanning)
      match /tickets/{ticketId} {
        allow create: if true;
        allow read, update, delete: if request.auth != null;
      }
    }

    // Users collection (public read for committee members and directory; writes require auth)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public applications form submission
    match /applications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Public visitor interactions telemetry logging
    match /visitor_interactions/{interactionId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // All other collections require authentication for both read and write
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}